# Reference: <https://postmarketos.org/devicepkg>
maintainer="Veynamer <veyr1thalone@gmail.com>"
pkgname=device-infinix-x6816d
pkgdesc="Infinix Hot 12 play NFC"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-unisoc-ums512
	android-tools
	linux-postmarketos-unisoc-ums512
	postmarketos-base
	firmware-infinix-x6816d-touchscreen
	firmware-infinix-x6816d-wcn
	u-boot-infinix-x6816d
"
makedepends="devicepkg-dev"
source="
	90-firmware-loader.rules
	deviceinfo
	load-firmware.sh
	modules-initfs
	pulse-infinix-x6816d.conf
"

build() {
	devicepkg_build $startdir $pkgname

	# Generate a dummy initramfs for the chainloadable U-Boot image
	# NOTE: must not be zero-filled empty file, otherwise bootloader complains
	echo "this is empty" > dummy-initramfs
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/pulse-infinix-x6816d.conf \
		"$pkgdir"/etc/pulse/daemon.conf.d/89-infinix-x6816d.conf
	install -Dm644 dummy-initramfs \
		"$pkgdir"/usr/share/u-boot/infinix-x6816d/dummy-initramfs
	install -Dm644 "$srcdir"/90-firmware-loader.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm755 "$srcdir"/load-firmware.sh \
		"$pkgdir"/usr/libexec/infinix-x6816d-firmware.sh
}

