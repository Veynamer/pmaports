maintainer="Veynamer <veyr1thalone@gmail.com>"
pkgname=firmware-infinix-x6816d
pkgver=1
pkgrel=1
pkgdesc="Firmware for the Infinix Hot 12 Play NFC"
url="https://github.com/Veynamer/firmware-infinix-x6816d"
arch="aarch64"
license="proprietary"
subpackages="$pkgname-touchscreen"
makedepends="python3"
options="!check !archcheck !strip !spdx !tracedeps pmb:cross-native"

_commit="1d703301f4a53ea2baa0f756ae0c07fccda4e3ae"
source="
	https://github.com/Veynamer/firmware-infinix-x6816d/archive/$_commit/firmware-$_commit.tar.gz
	10-touch-firmware.files
"
builddir="$srcdir/firmware-infinix-x6816d-$_commit"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

touchscreen() {
	pkgdesc="Infinix Hot 12 Play NFC touchscreen firmware"

	install -Dm644 "$builddir/omnivision/X6816DRU_TD4160_TM_fw.img" -t \
		"$subpkgdir/lib/firmware/omnivision/"
	install -Dm644 "$srcdir/10-touch-firmware.files" -t \
		"$subpkgdir/usr/share/mkinitfs/files/"
}

