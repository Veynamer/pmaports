db4e0599a611038a242aa9b08c5c255b3165c0d9202a3a85fbbdfe35b3a25fc39f21370e59a141961ff91201dad3aeeda7bfc1ed36967e654658fcf46eb30cd5  10-touch-firmware.files
"
